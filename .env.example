# Copy to .env and fill in real values. Never commit .env.

# Path of the SQLite database file (created automatically).
DATABASE_PATH=data/ledger.db

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# bcrypt cost factor (12 is a good default; tests use 4 for speed).
BCRYPT_ROUNDS=12

# Rate limiting on sensitive endpoints (login, register, transfers, admin actions).
RATE_LIMIT_ENABLED=true

LOG_LEVEL=INFO

# Only read by scripts/create_admin.py. Leave empty to be prompted instead.
ADMIN_PASSWORD=
